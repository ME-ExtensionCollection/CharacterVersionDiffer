{
  "name": "marinara-char-differ",
  "version": "0.1.0",
  "private": true,
  "description": "Marinara Engine extension: compare a character card with a saved version in meld and save the merged result.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/build.mjs --check && node --test test/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "smoke": "node scripts/smoke.mjs",
    "helper": "node helper/chardiffer-helper.mjs"
  }
}
